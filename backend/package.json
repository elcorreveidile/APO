{
  "name": "estoy-bien-backend",
  "version": "1.0.0",
  "description": "Backend API para la aplicación Estoy Bien - Sistema de check-in diario",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node start-dev.js",
    "dev:watch": "nodemon start-dev.js",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "db:test": "node scripts/test-db.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/seed.js --force",
    "diagnose": "node scripts/diagnose.js",
    "setup": "npm install && node scripts/diagnose.js"
  },
  "keywords": [
    "checkin",
    "health",
    "notifications",
    "alerts"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "twilio": "^4.19.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.3.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
